              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "results", "my"],
              "query": [
                { "key": "semester", "value": "First", "description": "Optional filter: First or Second" },
                { "key": "academicYear", "value": "2023/2024", "description": "Optional filter: e.g. 2023/2024" }
